# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# DATABASE CONFIGURATION: SUPABASE / POSTGRESQL / CLOUD SQL
# (Optional: If left empty, safe in-memory persistence is automatically active)
# ==============================================================================

# Option 1: Direct Supabase PostgreSQL Connection URI (Supabase Dashboard -> Settings -> Database)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Option 2: Parameterized PostgreSQL Connection
SQL_HOST="db.[PROJECT-REF].supabase.co"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="[YOUR-PASSWORD]"
SQL_DB_NAME="postgres"

# Option 3: Supabase Client SDK (Project URL and Anon API Key)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
